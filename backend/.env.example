# ---- core ----
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-generated-secret
JWT_EXPIRES_IN=2h
# your Vercel URL, no trailing slash (use http://localhost:3000 locally)
CLIENT_ORIGIN=https://your-site.vercel.app
LOG_LEVEL=info

# ---- AI text: gemini (free tier) or openai (paid) ----
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini

# ---- AI thumbnails: none (free, gradient placeholder) or openai (paid, DALL-E 3) ----
IMAGE_PROVIDER=none
OPENAI_IMAGE_MODEL=dall-e-3

# ---- contact form email: resend (HTTPS, works on Render free) or smtp ----
EMAIL_PROVIDER=resend
CONTACT_TO=you@example.com
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- tamper layer ----
TAMPER_BEACON_ENABLED=false
TAMPER_BEACON_URL=
